diff --git a/crates/engine/src/fonts.rs b/crates/engine/src/fonts.rs
index 97a8306..e0acedd 100644
--- a/crates/engine/src/fonts.rs
+++ b/crates/engine/src/fonts.rs
@@ -28,10 +28,11 @@ impl CraftFont {
     }
 
     /// Whether the font can stand in for `script`: it is meant for it, or — until craft-fonts has a
-    /// Traditional Chinese face — it is a Simplified Chinese face, which carries the Traditional
-    /// characters too (with mainland glyph forms; still closer than the Japanese faces).
+    /// Traditional Chinese or a Korean face — it is a Simplified Chinese face. Noto Sans CJK SC
+    /// carries the Traditional characters (with mainland glyph forms; still closer than the
+    /// Japanese faces) and every Hangul syllable, which the Japanese faces lack.
     pub fn serves(&self, script: &str) -> bool {
-        self.covers(script) || (script == "Hant" && self.covers("Hans"))
+        self.covers(script) || (matches!(script, "Hant" | "Kore") && self.covers("Hans"))
     }
 }
 
@@ -108,6 +109,10 @@ mod tests {
         assert_eq!(first("Jpan"), Some("BIZ UDPGothic"));
         // No Traditional Chinese face yet: the Chinese face stands in before the Japanese ones.
         assert_eq!(first("Hant"), Some("Noto Sans CJK SC"));
+        // No Korean face yet either: Noto Sans CJK carries every Hangul syllable, and its Han forms
+        // are closer to Korean ones than the Japanese faces', so it comes first for Korean too.
+        assert_eq!(first("Kore"), Some("Noto Sans CJK SC"));
+        assert!(FACES[1].serves("Kore") && !FACES[0].serves("Kore"));
         // Every CJK face is still offered to every language.
         assert_eq!(cjk_fallback(FACES, "Hans", "Regular").len(), 3);
         assert_eq!(cjk_fallback(&[], "Hans", "Regular").len(), 0);
