+            assert_eq!(first.map(String::as_str), Some("craft-fonts Noto Sans CJK SC Regular"), "{family:?}: {names:?}");
+        }
+        let ctx = fonts_ctx(craft);
+        ctx.fonts_mut(|fonts| {
+            for family in [egui::FontFamily::Proportional, egui::FontFamily::Name(crate::theme::FONT_SEMIBOLD.into()), egui::FontFamily::Monospace] {
+                let font = egui::FontId::new(13.0, family);
+                let missing: String = ('\u{ac00}'..='\u{d7a3}').filter(|ch| !fonts.has_glyph(&font, *ch)).collect();
+                assert!(missing.is_empty(), "{font:?} lacks {} Hangul syllable(s): {missing}", missing.chars().count());
+                let sample = "한국어사진현상";
+                let galley = fonts.layout_no_wrap(sample.into(), font.clone(), egui::Color32::WHITE);
+                assert!(galley.size().x > 13.0 * (sample.chars().count() as f32 - 1.0), "{font:?}: full-width Hangul, {:?}", galley.size());
+            }
+        });
+        set_language(Locale::En);
+    }
 }
