+    /// Korean's coverage of every message the other catalogs carry, and of the format strings. Gaps
+    /// are reported, not failed (like `ukrainian_coverage_of_catalogs_commands_controls_and_rules_is_reported`):
+    /// a feature PR doesn't have to ship its Korean text. Korean is written in Hangul: kana or the
+    /// full-width punctuation of Japanese and Chinese never belong in it.
+    #[test]
+    fn korean_coverage_is_reported_and_the_catalog_is_hangul() {
+        let catalog = korean().catalog();
+        let keys: std::collections::BTreeSet<&String> = Locale::ALL.iter().flat_map(|language| language.catalog().keys()).collect();
+        let lacking: Vec<_> = keys.into_iter().filter(|key| !catalog.contains_key(key.as_str())).collect();
+        if !lacking.is_empty() {
+            eprintln!("ko lacks {} catalog message(s) (shown in English): {lacking:?}", lacking.len());
+        }
+        let dir = std::path::Path::new(env!("CARGO_MANIFEST_DIR")).join("locales");
+        let korean_formats: BTreeMap<String, String> = serde_json::from_str(&std::fs::read_to_string(dir.join("ko-formats.json")).unwrap()).unwrap();
+        // Messages that read the same in Korean (a unit, bare values) are the only ones left as written.
+        let words = |text: &str| {
+            let (mut out, mut depth) = (String::new(), 0usize);
+            for ch in text.chars() {
+                match ch {
+                    '{' => depth += 1,
+                    '}' => depth = depth.saturating_sub(1),
+                    _ if depth == 0 => out.push(ch),
+                    _ => {}
+                }
+            }
+            out
+        };
+        let untranslated: Vec<_> = korean_formats
+            .iter()
+            .filter(|(key, value)| {
+                key == value
+                    && words(key).split(|ch: char| !ch.is_ascii_alphabetic()).any(|word| !word.is_empty() && !["KB", "MB", "GB"].contains(&word))
+            })
+            .map(|(key, _)| key)
+            .collect();
+        if !untranslated.is_empty() {
+            eprintln!("ko-formats.json has {} message(s) still in English: {untranslated:?}", untranslated.len());
+        }
+        // Hangul and the punctuation around it, never Japanese kana or the full-width forms
+        // Japanese and Chinese use.
+        for (key, value) in catalog.iter().chain(korean_formats.iter()) {
+            assert!(!value.chars().any(|ch| matches!(ch, '\u{3040}'..='\u{30ff}' | '、' | '。' | '「' | '」')), "{key:?} -> {value:?}");
+        }
+    }
